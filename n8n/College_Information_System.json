    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Loop over input items and add a new field called 'my_new_field' to the JSON of import re\n\nitems = _items\n\ndata = items[0][\"json\"]\n\ntitles = data.get(\"title\", [])\ncontents = data.get(\"content\", [])\n\noutput = []\n\nfor i in range(len(titles)):\n\n    title = titles[i].strip()\n\n    if i < len(contents):\n        content = contents[i].strip()\n    else:\n        content = \"\"\n\n    # Extract date\n    date = \"\"\n\n    if \"Date:\" in content:\n        date_part = content.split(\"Date:\", 1)[1]\n        date = date_part.split(\"\\n\", 1)[0].strip()\n\n    # Extract URLs without using import\n    urls = []\n\n    parts = content.split(\"[\")\n\n    for part in parts:\n        if \"https://\" in part:\n            url = part.split(\"]\", 1)[0].strip()\n\n            if url.startswith(\"https://\"):\n                urls.append(url)\n\n    # Last URL = complete report URL\n    if urls:\n        link = urls[-1]\n    else:\n        link = \"\"\n\n    output.append({\n        \"json\": {\n            \"title\": title,\n            \"date\": date,\n            \"link\": link,\n            \"content\": content,\n            \"type\": \"event\"\n        }\n    })\n\nreturn output"
      },
