    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Loop over input items and add a new field called 'my_new_field' to the JSON of each one\nitems = _items\n\ndata = items[0][\"json\"]\n\ntitles = data.get(\"title\", [])\nlinks = data.get(\"link\", [])\ncontents = data.get(\"content\", [])\n\noutput = []\n\nfor i in range(len(titles)):\n\n    title = titles[i]\n\n    if i < len(contents):\n        content = contents[i]\n    else:\n        content = \"\"\n\n    if i < len(links):\n        link = links[i]\n    else:\n        link = \"\"\n\n    # Extract publish date\n    date = \"\"\n\n    if \"Date of Publish:\" in content:\n        date_part = content.split(\"Date of Publish:\", 1)[1]\n        date = date_part.strip().split()[0]\n\n    # Convert relative URL to full URL\n    if link and not link.startswith(\"http\"):\n        link = \"https://www.cemkolaghat.in/\" + link\n\n    output.append({\n        \"json\": {\n            \"title\": title,\n            \"date\": date,\n            \"link\": link,\n            \"content\": content,\n            \"type\": \"news\"\n        }\n    })\n\nreturn output"
      },
